// Prisma schema for the menu API. Models are added per domain.
// After editing: pnpm nx run api-shared-db:prisma-migrate (dev) and commit the migration.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// --- users -----------------------------------------------------------------

enum Language {
  he
  en
}

/// A person who signed in with Firebase Authentication.
model Account {
  id          String   @id @default(uuid()) @db.Uuid
  firebaseUid String   @unique @map("firebase_uid")
  displayName String   @default("") @map("display_name")
  language    Language @default(he)
  isAdmin     Boolean  @default(false) @map("is_admin")
  createdAt   DateTime @default(now()) @map("created_at")

  ownerships Ownership[] @relation("owner")

  @@map("account")
}

/// Makes an account the Owner of one venue. Granted and revoked by Admins.
model Ownership {
  accountId   String   @map("account_id") @db.Uuid
  venueId     String   @map("venue_id") @db.Uuid
  grantedById String?  @map("granted_by_id") @db.Uuid
  grantedAt   DateTime @default(now()) @map("granted_at")

  account Account @relation("owner", fields: [accountId], references: [id], onDelete: Cascade)
  venue   Venue   @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@id([accountId, venueId])
  @@index([venueId])
  @@map("ownership")
}

// --- menus -----------------------------------------------------------------

enum VenueStatus {
  active
  hidden
}

/// A restaurant or bar. Names are stored per language (`name_en` falls back to Hebrew).
model Venue {
  id             String      @id @default(uuid()) @db.Uuid
  nameHe         String      @map("name_he")
  nameEn         String?     @map("name_en")
  address        String
  lat            Float
  lng            Float
  phone          String?
  reservationUrl String?     @map("reservation_url")
  status         VenueStatus @default(active)
  createdById    String?     @map("created_by_id") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at")

  sections   MenuSection[]
  ownerships Ownership[]
  items      Item[]

  @@index([lat, lng])
  @@map("venue")
}

/// A heading on a venue's menu, ordered by `position`.
model MenuSection {
  id       String  @id @default(uuid()) @db.Uuid
  venueId  String  @map("venue_id") @db.Uuid
  nameHe   String  @map("name_he")
  nameEn   String? @map("name_en")
  position Int

  venue Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)
  items Item[]

  @@index([venueId, position])
  @@map("menu_section")
}

enum TagKind {
  dish
  diet
  flavour
}

/// A word in the Admin-curated tag vocabulary.
model Tag {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  nameHe    String   @map("name_he")
  nameEn    String?  @map("name_en")
  kind      TagKind
  createdAt DateTime @default(now()) @map("created_at")

  items ItemTag[]

  @@map("tag")
}

enum ItemState {
  pending
  approved
  rejected
  merged
  archived
}

/// One dish or drink at one venue. `submitted_by_id` is set for user submissions
/// and never leaves the API.
model Item {
  id            String    @id @default(uuid()) @db.Uuid
  venueId       String    @map("venue_id") @db.Uuid
  sectionId     String    @map("section_id") @db.Uuid
  nameHe        String    @map("name_he")
  nameEn        String?   @map("name_en")
  listPrice     Int?      @map("list_price")
  state         ItemState @default(approved)
  submittedById String?   @map("submitted_by_id") @db.Uuid
  mergedIntoId  String?   @map("merged_into_id") @db.Uuid
  position      Int
  createdAt     DateTime  @default(now()) @map("created_at")

  venue   Venue       @relation(fields: [venueId], references: [id], onDelete: Cascade)
  section MenuSection @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  tags    ItemTag[]
  entries Entry[]

  @@index([venueId, state])
  @@index([submittedById])
  @@map("item")
}

/// A tag applied to an item. `position` 0 is the item's primary tag.
model ItemTag {
  itemId   String @map("item_id") @db.Uuid
  tagId    String @map("tag_id") @db.Uuid
  position Int

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([itemId, tagId])
  @@index([tagId])
  @@map("item_tag")
}

enum EntryVisibility {
  private
  shared
  public
}

/// One line in a user's diary about one item. `author_id` never leaves the
/// entries domain and has no foreign key (accounts belong to users, ADR 0004);
/// `venue_id` is copied from the item for history per venue. Items are archived,
/// never deleted, so the item reference restricts deletes.
model Entry {
  id              String          @id @default(uuid()) @db.Uuid
  authorId        String          @map("author_id") @db.Uuid
  itemId          String          @map("item_id") @db.Uuid
  venueId         String          @map("venue_id") @db.Uuid
  eatenAt         DateTime        @map("eaten_at")
  rating          Int?
  wouldOrderAgain Boolean?        @map("would_order_again")
  pricePaid       Int?            @map("price_paid")
  text            String          @default("")
  visibility      EntryVisibility @default(private)
  shareToken      String?         @unique @map("share_token")
  hiddenAt        DateTime?       @map("hidden_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  item Item @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([authorId, eatenAt])
  @@index([itemId, visibility])
  @@index([venueId])
  @@map("entry")
}
