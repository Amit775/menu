# Copy to .env (gitignored). Defaults match docker-compose.yml.
DATABASE_URL=postgresql://menu:menu@localhost:5432/menu
PORT=3000
ADMIN_FIREBASE_UIDS=
# Firebase project whose ID tokens are accepted (default menu-b29eb).
FIREBASE_PROJECT_ID=
# Local development and e2e only: accept `dev:<uid>:<name>` bearer tokens. Ignored in production.
AUTH_DEV_TOKENS=false
# Keep entry photos in this folder instead of the Firebase Storage bucket (local development, e2e).
PHOTO_DIR=tmp/photos
# The Cloud Storage bucket for photos when PHOTO_DIR is empty (default <project>.firebasestorage.app).
PHOTO_BUCKET=
