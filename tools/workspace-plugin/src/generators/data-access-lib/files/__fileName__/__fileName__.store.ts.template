import { computed, inject } from '@angular/core';
import { type Create<%= className %>, type <%= className %> } from '@menu/shared/contracts';
import { patchState, signalStore, withComputed, withMethods, withState } from '@ngrx/signals';
import { <%= className %>ApiClient } from './<%= fileName %>.api-client';

interface <%= className %>State {
  items: <%= className %>[];
  loading: boolean;
  error: string | null;
}

const initialState: <%= className %>State = { items: [], loading: false, error: null };

export const <%= className %>Store = signalStore(
  withState(initialState),
  withComputed(({ items }) => ({
    count: computed(() => items().length),
  })),
  withMethods((store, api = inject(<%= className %>ApiClient)) => ({
    async load(): Promise<void> {
      patchState(store, { loading: true, error: null });
      try {
        patchState(store, { items: await api.list(), loading: false });
      } catch {
        patchState(store, { loading: false, error: 'Could not load <%= fileName %>.' });
      }
    },
    async create(input: Create<%= className %>): Promise<void> {
      const created = await api.create(input);
      patchState(store, { items: [...store.items(), created] });
    },
  })),
);
