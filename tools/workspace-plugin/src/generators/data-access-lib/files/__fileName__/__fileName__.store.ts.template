import { computed, inject, resource, signal } from '@angular/core';
import { type Create<%= className %> } from '@menu/shared/contracts';
import { loadStatus } from '@menu/web/shared/util-data';
import { signalStore, withComputed, withMethods, withProps } from '@ngrx/signals';
import { <%= className %>ApiClient } from './<%= fileName %>.api-client';

export const <%= className %>Store = signalStore(
  withProps((_, api = inject(<%= className %>ApiClient)) => {
    const requested = signal(false);
    return {
      _requested: requested,
      _items: resource({
        params: () => (requested() ? {} : undefined),
        loader: () => api.list(),
      }),
    };
  }),
  withComputed(({ _items }) => {
    const items = computed(() => (_items.hasValue() ? _items.value() : []));
    return { items, count: computed(() => items().length), status: loadStatus(_items) };
  }),
  withMethods(({ _requested, _items }, api = inject(<%= className %>ApiClient)) => ({
    load(): void {
      _requested.set(true);
    },
    reload(): void {
      _items.reload();
    },
    async create(input: Create<%= className %>): Promise<void> {
      const created = await api.create(input);
      if (_items.hasValue()) {
        _items.set([..._items.value(), created]);
      } else {
        _items.reload();
      }
    },
  })),
);
