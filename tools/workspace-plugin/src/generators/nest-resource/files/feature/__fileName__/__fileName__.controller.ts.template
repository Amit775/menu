import { Body, Controller, Get, Post } from '@nestjs/common';
import { ZodValidationPipe } from '@menu/api/shared/util';
import {
  type Create<%= className %>,
  Create<%= className %>Schema,
  <%= propertyName %>Path,
  type <%= className %>,
} from '@menu/shared/contracts';
import { <%= className %>Service } from './<%= fileName %>.service';

/** `/api/<%= fileName %>`: HTTP only. Validation via the shared contract, logic in the service. */
@Controller(<%= propertyName %>Path)
export class <%= className %>Controller {
  constructor(private readonly service: <%= className %>Service) {}

  @Get()
  list(): Promise<<%= className %>[]> {
    return this.service.list();
  }

  @Post()
  create(
    @Body(new ZodValidationPipe(Create<%= className %>Schema)) input: Create<%= className %>,
  ): Promise<<%= className %>> {
    return this.service.create(input);
  }
}
